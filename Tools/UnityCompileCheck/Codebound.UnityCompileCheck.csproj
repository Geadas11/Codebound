<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile-only check of the Unity-dependent runtime code (Scripts/Game) outside the Unity editor.
    Uses Unity's reference assemblies from the NuGet package UnityEngine.Modules (2021.3 API surface)
    downloaded to UNITY_REF_DIR (see README "Verificação sem Unity"). The DLLs are NOT committed or shipped.
    Limitations: Input System package and UnityEditor are not available here, so the legacy-input branch of
    GameInput is compiled and Editor scripts are skipped. Unity 6-only APIs would show up as errors here.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityRefDir Condition="'$(UNITY_REF_DIR)' == ''">/tmp/unityref/pkg/lib/netstandard2.0</UnityRefDir>
    <UnityRefDir Condition="'$(UNITY_REF_DIR)' != ''">$(UNITY_REF_DIR)</UnityRefDir>
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Codebound/Assets/_Codebound/Scripts/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(UnityRefDir)/*.dll" Private="false" />
  </ItemGroup>
</Project>

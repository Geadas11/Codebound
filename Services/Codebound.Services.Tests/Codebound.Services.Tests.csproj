<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The game's own online client (engine-free Unity code), tested here against the real service -->
  <ItemGroup>
    <Compile Include="..\..\Codebound\Assets\Codebound\Scripts\Core\Json.cs" Link="GameClient\Json.cs" />
    <Compile Include="..\..\Codebound\Assets\Codebound\Scripts\Core\Online\*.cs" Link="GameClient\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codebound.Services\Codebound.Services.csproj" />
  </ItemGroup>

</Project>
